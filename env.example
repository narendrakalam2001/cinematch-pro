# Copy this file to `.env` and fill in real values.
# Never commit your actual .env file.

# --- TMDB API (https://www.themoviedb.org/documentation/api) ---
# Free tier: 1000 requests/day. Used for movie details, cast photos, trailers.
TMDB_API_KEY=your_tmdb_api_key_here

# --- OMDB API (https://www.omdbapi.com) ---
# Free tier. Used for IMDB ratings and awards data.
OMDB_API_KEY=your_omdb_api_key_here

# --- Gemini API (for CineBot / LangChain) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model id (retired ones return "model not found"; see ai.google.dev/gemini-api/docs/deprecations)
GEMINI_MODEL=gemini-3.5-flash

# --- Trained models (Hugging Face Hub) ---
# Public repo: the app downloads the trained models on first start, no token needed.
# Use "lite" mode (CINEMATCH_LITE=1) to download only the ~70 MB catalogue + TF-IDF subset.
HF_ARTIFACTS_REPO=narendrakalam2001/cinematch-pro-artifacts
# Only needed if you keep your own artifacts repo private (a READ token):
# HF_TOKEN=hf_your_read_token_here

# --- App settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
